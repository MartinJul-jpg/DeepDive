@using DeepDive.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers



<p>
    <div id="forecastCard" class="row d-flex justify-content-evenly">
        <div id="todaysForecastDayCard" class="col justify-content-evenly forecastDayCard" style="width: 12%;">
            <img class="forecastImg" src="~/images/WeatherCodeImages/WeatherCode65.png" alt="Weather Code 65" />
        </div>
        <div class="col justify-content-evenly forecastDayCard" style="width: 12%;">
            <img class="forecastImg" src="~/images/WeatherCodeImages/WeatherCode65.png" alt="Weather Code 65" />
        </div>
        <div class="col justify-content-evenly forecastDayCard" style="width: 12%;">
            <img class="forecastImg" src="~/images/WeatherCodeImages/WeatherCode65.png" alt="Weather Code 65" />
        </div>
        <div class="col justify-content-evenly forecastDayCard" style="width: 12%;">
            <img class="forecastImg" src="~/images/WeatherCodeImages/WeatherCode65.png" alt="Weather Code 65" />
        </div>
        <div class="col justify-content-evenly forecastDayCard" style="width: 12%;">
            <img class="forecastImg" src="~/images/WeatherCodeImages/WeatherCode65.png" alt="Weather Code 65" />
        </div>
        <div class="col justify-content-evenly forecastDayCard" style="width: 12%;">
            <img class="forecastImg" src="~/images/WeatherCodeImages/WeatherCode65.png" alt="Weather Code 65" />
        </div>
        <div class="col justify-content-evenly forecastDayCard" style="width: 12%;">
            <img class="forecastImg" src="~/images/WeatherCodeImages/WeatherCode65.png" alt="Weather Code 65" />
        </div>
    </div>
    <br />
    <h1 class="text-decoration-underline">Pakke tilbud</h1>
    <div class="d-flex justify-content-center flex-wrap">
        @foreach (Package package in Model)
        {
            double _price = 0;
            <a id="productText" class="card m-1" asp-controller="Package" asp-action="Show" asp-route-id="@($"{package.PackageId}")">
                <div class="d-flex justify-content-evenly  flex-wrap" style="width: 32rem; height: 80%; padding: 24px">
                    @foreach (Package_Product pp in package.Package_Products)
                    {
                        _price += pp.Product.Price;
                        <img src="@Url.Content(pp.Product.ImgPath)" class="packageImg" style="width: 8rem; height: 8rem" alt="...">
                    }
                </div>
                <h4 id="packageText" class="card-text">Pakkeløsning @package.PackageId - @_price kr. per dag</h4>
            </a>
        }
    </div>
</p>