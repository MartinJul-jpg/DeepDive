@using DeepDive.Models
@using DeepDive.ViewModels
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model HomeViewModel;

<section class="hero-section">
    @* <img src="~/lib/custom/resource/frontpage-diver.jpg"
         alt="Diver"
         class="hero-image"> *@

    <div class="hero-overlay"></div>

    <div class="hero-overlay">
        <div>
            <div>

                <div>
                    <h1 class="hero-title" style="color: #DFF0F7; font-size: clamp(64px, 12vw, 140px); font-weight: 900;">
                        DYBT
                        <br>
                        <span style="color: #00B4D8;">UNDER</span>
                        <br>
                        VANDET
                    </h1>

                    <p class="hero-text" style="color: #9DC8DB;">
                        Lej komplet dykkerudstyr af høj kvalitet.
                        Alt fra BCD og dragter til tanke og regulatorsæt.
                        Serviceret og klar til dit næste dyk.
                    </p>
                </div>

            </div>
        </div>
    </div>
</section>

