@using DeepDive.Models
@using DeepDive.ViewModels
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model HomeViewModel;

<div id="forecastCard" class="justify-content-evenly">
    <form asp-action="Index" asp-controller="Home">
        <input type="search" name="searchTerm" />
        <input type="submit" />
    </form>
    <div class="row d-flex justify-content-evenly">
        <div id="todaysForecastDayCard" class="col justify-content-evenly forecastDayCard">
            <h4 class="forecastDayText">@(Model.ForecastViewModel.WeatherForecast.TimeStamps[0].ToShortDateString())</h4>
            <img class="forecastImg" src="~/images/WeatherCodeImages/WeatherCode@(Model.ForecastViewModel.WeatherForecast.WeatherCode[0]).png" alt="TodayForecast" />
            @if (Model.ForecastViewModel.MarineForecast.WaveHeight[11] < 1.5
            && Model.ForecastViewModel.WeatherForecast.PrecipitationSum[0] < 2
            && Model.ForecastViewModel.WeatherForecast.WeatherCode[0] != 95
            && Model.ForecastViewModel.WeatherForecast.WeatherCode[0] != 96
            && Model.ForecastViewModel.WeatherForecast.WeatherCode[0] != 97
            && Model.ForecastViewModel.WeatherForecast.WeatherCode[0] != 99
            && Model.ForecastViewModel.WeatherForecast.WindSpeed10mMax[0] < 8)
            {
                <p>
                    Forslået at dykke: Ja
                </p>
            }
            else
            {
                <p>
                    Forslået at dykke: Nej
                </p>
            }
            @{
                var temp0 = Model.ForecastViewModel.MarineForecast.SeaSurfaceTempearture[11];
                var tempCategory0 = temp0 switch
                {
                    < 10 => "Tørdragt",
                    >= 10 and < 18 => "Våddragt (7mm)",
                    >= 18 and < 24 => "Våddragt (5mm)",
                    _ => "Våddragt (3mm)"
                };
            }
            <p>@tempCategory0</p>
        </div>
