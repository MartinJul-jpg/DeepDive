@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@using DeepDive.Models

<div class="d-flex justify-content-center flex-wrap" id="productGrid">
    @foreach (Product product in Model)
    {
        <a id="productText" asp-controller="Product" asp-action="Show" asp-route-id="@($"{product.ProductId}")" class="card m-3" style="width: 18rem;">
            <img src="~/lib/custom/resource/product-placeholder.png" class="card-img-top h-auto" alt="...">
            <div class="card-body">
                <h6 class="card-text">@($"{product.GetUniqueInfo()}")</h6>
            </div>
        </a>
    }
</div>
