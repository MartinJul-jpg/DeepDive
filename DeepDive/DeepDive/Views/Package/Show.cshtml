@model Package;
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using DeepDive.Models;

@{
    double _price = 0;
    <div class="container text-center m-5">
        <div class="row">
            <div class="col">
                <div id="packageImageContainer" class="card d-flex flex-wrap justify-content-evenly align-content-center">
                    @foreach (Package_Product pp in Model.Package_Products)
                    {
                        <img src="~/lib/custom/resource/product-placeholder.png" class="packageImg">
                        _price += pp.Product.Price;
                    }
                </div>
            </div>
            <div class="col productText">
                <h3>Pakke: @Model.PackageId</h3>
                <br />
                <h5>Pris: @_price kr. per dag</h5>
            </div>
            <div class="col">
                <a class="btn btn-primary" asp-controller="Package" asp-action="AddPackageToBasket" asp-route-id="@Model.PackageId">Book</a>
            </div>
        </div>
    </div>
}
