@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelper
@using DeepDive.Models;

@*  *@
<div class="container text-center m-5">
    <div class="row">
        <div class="col">
            <div id="packageImageContainer">
                @foreach (Product product in Model.setList)
                {
                    <img src="~/lib/custom/resource/product-placeholder.png" class="card" style="width: 12rem; height: 12rem;">
                }
            </div>
        </div>
        <div class="col">
            <h3>Pakke: @Model.PackageId</h3>
        </div>
        <div class="col">
            <a class="btn btn-primary" asp-controller="Product" asp-action="AddToBasket" asp-route-id="">Book</a>
        </div>
    </div>
</div>
