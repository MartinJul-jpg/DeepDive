@model List<Product> 



<div class="d-flex justify-content-between align-items-center mt-4 mb-4">
    <h1 class="mb-0">Products:</h1>
    <a asp-controller="Admin" asp-action="CreateNewProduct" class="btn btn-primary">+ New Product</a>
    <a asp-controller="Admin" asp-action="ViewBooking" class="btn btn-info"> Bookings</a>
</div>

<div class="d-flex flex-wrap gap-3">

    <table class="table table-striped">
        <thead>
            <tr>
                <th scope="col">ProductId</th>
                <th scope="col">Type</th>
                <th scope="col">Amount</th>
                <th scope="col">Brand</th>
                <th scope="col">Price</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.ProductId</td>
                    <td>@product.GetType().Name</td>
                    <td>@product.Amount</td>
                    <td>@product.Brand</td>
                    <td>@product.Price</td>
                    <td>
                        <a asp-controller="Admin" asp-action="EditProduct" asp-route-id="@product.ProductId" class="btn btn-link">Edit</a>
                        <a asp-controller="Admin" asp-action="DeleteProduct" asp-route-id="@product.ProductId" class="btn btn-link">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>