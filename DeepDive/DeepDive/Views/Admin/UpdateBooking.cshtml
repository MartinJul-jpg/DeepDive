@model Booking

@{
    string action = ViewBag.Action ?? string.Empty;
}

<form method="post" asp-controller="Admin" asp-action="@action">
    @if (action == "UpdateBooking")
    {
        <input type="hidden" asp-for="BookingId" />
        <input type="hidden" asp-for="Finalized" />
        <input type="hidden" asp-for="Product_Bookings" />

        <input type="hidden" asp-for="RowVersion" />
    } 

    <div class="form-floating mb-3">
        <input asp-for="UserId" id="floatingPrice" class="form-control" placeholder="1" />
        <label for="floatingPrice">UserId</label>
    </div>

    @{
        // the two following divs containing the fields for the user class instance and the list of products cannot be returned via form because of framework limitations. 
        // fear not, leaving the fields empty when the forms output instance is used to update wont cause the booking on the database to lose these informations. 
        // the real point might be that if you want to update user, userId should be updated instead, the database handles the rest. 
        // in regards to updating the product contents of the booking, one could get some numbers from here to the controller representing the products to be added or removed etc. 
    }
    <div class="form-floating mb-3">
        <input asp-for="User" id="floatingAmount" class="form-control" placeholder="1" />
        <label for="floatingAmount">User</label>
    </div>
    <div class="form-floating mb-3">
        <select class="form-select">
            @foreach (var product in Model.Product_Bookings)
            {
                <option>BookedProduct: @product.Product.GetType().Name & BookingId: @product.BookingId</option> 
            }
            </select>
    </div>

    <div class="form-floating mb-3">
        <input asp-for="Start" id="floatingPrice" class="form-control" placeholder="1" />
        <label for="floatingPrice">BookingStart</label>
    </div>
    <div class="form-floating mb-3">
        <input asp-for="End" id="floatingAmount" class="form-control" placeholder="1" />
        <label for="floatingAmount">BookingEnd</label>
    </div>
  
    <div class="mb-3">
        <input type="submit" class="btn-success" value="Save"/>
    </div>
    
    <div class="text-danger" asp-validation-summary="All"></div>

</form>