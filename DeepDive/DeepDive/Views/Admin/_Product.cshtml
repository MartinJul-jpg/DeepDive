@model Product

@{
    string action = ViewBag.Action ?? string.Empty;
}

<form method="post" asp-controller="Admin" asp-action="@action">
    @if (action == "EditProduct")
    {
        <input type="hidden" asp-for="ProductId" />

    }

    <div class="mb-3">

        <select id="productTypeSelector" asp-for="Brand" class="form-select">
            <option value="BCD">BCD</option>
            <option value="DivingSuit">DivingSuit</option>
            <option value="Fin">Fin</option>
            <option value="RegulatorSet">RegulatorSet</option>
            <option value="Snorkel">Snorkel</option>
            <option value="Tank">Tank</option>
        </select>

        <input asp-for="Price" class="form-label" />

        <div id="fieldsBCD" class="subclassFields" style="display:none;">
            <input type="text" name="Model" value="@((Model as BCD)?.Model)" />
            <input type="text" name="Size" value="@((Model as BCD)?.Size)" />
        </div>

        <div id="fieldsDivingSuit" class="subclassFields" style="display:none;">
            <input type="text" name="Model" value="@((Model as DivingSuit)?.Model)" />
            <input type="text" name="Size" value="@((Model as DivingSuit)?.Size)" />
            <input type="text" name="Type" value="@((Model as DivingSuit)?.Type)" />
            <input type="text" name="Gender" value="@((Model as DivingSuit)?.Gender)" />
            <input type="text" name="Thickness" value="@((Model as DivingSuit)?.Thickness)" />
        </div>

        <div id="fieldsFin" class="subclassFields" style="display:none;">
            <input type="text" name="Model" value="@((Model as Fin)?.Model)" />
            <input type="text" name="Size" value="@((Model as Fin)?.Size)" />
        </div>

        <div id="fieldsRegulatorSet" class="subclassFields" style="display:none;">
            <input type="text" name="FirstStage" value="@((Model as RegulatorSet)?.FirstStage)" />
            <input type="text" name="SecondStage" value="@((Model as RegulatorSet)?.SecondStage)" />
            <input type="text" name="Octopus" value="@((Model as RegulatorSet)?.Octopus)" />
        </div>

        <div id="fieldsSnorkel" class="subclassFields" style="display:none;">
            <input type="text" name="Model" value="@((Model as Snorkel)?.Model)" />
        </div>

        <div id="fieldsTank" class="subclassFields" style="display:none;">
            <input type="text" name="Model" value="@((Model as Tank)?.Volume)" />
        </div>
    </div> 
    <div>
        <input type="submit" class="btn-success" value="Save" />
    </div>
</form>

<script>
    document.addEventListener("DOMContentLoaded", function () {
          const selector = document.getElementById("productTypeSelector");

          function toggleFields() {
              const selectedType = selector.value;

            const sections = document.querySelectorAll(".subclassFields");

              sections.forEach(sec => sec.style.display = "none");

              const activeSection = document.getElementById("fields" + selectedType);
              if (activeSection) {
                  activeSection.style.display = "block";
              }
          }

          selector.addEventListener("change", toggleFields);
          toggleFields(); 
      });
</script>
