@model SearchQuery;

<form id="searchForm" asp-controller="Search" asp-action="Show" method="post">
    <div class="d-flex flex-wrap justify-content-center align-content-center">
        <input type="text" asp-for="Query" value="@Model.Query" />
        <button id="searchBtn" onclick="document.getElementById('searchForm').submit()"> SØG </button>
    </div>
</form>

<p>
    <div class="d-flex justify-content-center flex-wrap">
        @if (Model.Packages != null)
        {
            @foreach (Package package in Model.Packages)
            {
                double _price = 0;
                <a id="productText" class="card m-1" asp-controller="Package" asp-action="Show" asp-route-id="@($"{package.PackageId}")">
                    <div class="d-flex justify-content-evenly  flex-wrap" style="width: 32rem; height: 80%; padding: 24px">
                        @foreach (Package_Product pp in package.Package_Products)
                        {
                            _price += pp.Product.Price;
                            <img src="@Url.Content(pp.Product.ImgPath)" class="packageImg" style="width: 8rem; height: 8rem" alt="...">
                        }
                    </div>
                    <h4 id="packageText" class="card-text">Pakkeløsning @package.PackageId - @_price kr. per dag</h4>
                </a>
            }
        }
    </div>
</p>

<p>
    <div class="d-flex justify-content-center flex-wrap" id="productGrid">
        @if (Model.Products != null)
        {
            @foreach (Product product in Model.Products)
            {
                <a id="productText" asp-controller="Product" asp-action="Show" asp-route-id="@($"{product.ProductId}")" class="card m-3" style="width: 15vw; height: 18vw;">
                    <img src="@Url.Content(product.ImgPath)" class="categoryImg card-img-top h-auto" alt="...">
                    <div class="card-body p-0 productCardText" style="height: 4vw;">
                        <p class="card-text m-0" style="font-size: 2vh;">@product.Brand</p>
                        <h6>Kr. @product.Price per. dag</h6>
                    </div>
                </a>
            }
        }
    </div>
</p>