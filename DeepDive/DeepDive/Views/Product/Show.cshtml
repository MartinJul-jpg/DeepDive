@using DeepDive.ViewModels
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model BookingViewModel;

<div class="container text-center m-5">
    <div class="row">
        <div class="col">
            <img src="~/lib/custom/resource/product-placeholder.png" class="card">
        </div>
        <div class="col productText">
            <h3>@($"{Model.Product.Brand}")</h3>
            <br />
            <h5>@($"{Model.Product.GetUniqueInfoPage()}")</h5>
            <br />
            <h5>Pris: @Model.Product.Price kr. per dag</h5>
        </div>
        <div class="col">
            <a class="btn btn-primary" asp-controller="Product" asp-action="AddToBasket" asp-route-id="@Model.Product.ProductId">Book</a>
        </div>
    </div>
</div>

