@using DeepDive.ViewModels
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model BookingViewModel;
@section categorySector {
    <div id="categoryDiv">
        <a asp-controller="Category" asp-action="Show" asp-route-id="BCD" class="btn categoryBtn btn-secondary">
            BCD
        </a>
        <a asp-controller="Category" asp-action="Show" asp-route-id="DivingSuit" class="btn categoryBtn btn-secondary">
            Dragter
        </a>
        <a asp-controller="Category" asp-action="Show" asp-route-id="Fin" class="btn categoryBtn btn-secondary">
            Finner
        </a>
        <a asp-controller="Category" asp-action="Show" asp-route-id="RegulatorSet" class="btn categoryBtn btn-secondary">
            Regulatorsæt
        </a>
        <a asp-controller="Category" asp-action="Show" asp-route-id="Snorkel" class="btn categoryBtn btn-secondary">
            Snorkler
        </a>
        <a asp-controller="Category" asp-action="Show" asp-route-id="Tank" class="btn categoryBtn btn-secondary">
            Tanke
        </a>
    </div>
}
<div class="container text-center m-5">
    <div class="row">
        <div class="col">
            <img src="~/lib/custom/resource/product-placeholder.png" class="card">
        </div>
        <div class="col">
            <h3>@($"{Model.Product.Brand}")</h3>
            <br />
            @($"{Model.Product.GetUniqueInfoPage()}")
            <br />
            @($"Pris: {Model.Product.Price} kr. per dage")
            <br />
            @($"Mængde: {Model.Product.Amount}")
        </div>
        <div class="col">
            <a class="btn btn-primary" id="BookBtn" asp-controller="Product" asp-action="AddToBasket" asp-route-id="@Model.Product.ProductId">Book</a>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        const link = document.getElementById('BookBtn');
        const amount = @Model.Product.Amount;
        link.addEventListener('click', (event) => {
            if (amount <= 0) {
                event.preventDefault();
                alert('Produktet er Udbookede ')
            }
        });
    </script>
}
