@using DeepDive.ViewModels
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model BookingViewModel;


@{
    int amount = 1;
    <div class="container text-center m-5">
        <div class="row">
            <div class="col">
                <img src="~/lib/custom/resource/product-placeholder.png" class="card">
            </div>
            <div class="col productText">
                <h3>@($"{Model.Product.Brand}")</h3>
                <br />
                <h5>@($"{Model.Product.GetUniqueInfoPage()}")</h5>
                <br />
                <h5>@($"Pris: {Model.Product.Price} kr. per dage")</h5>
                <br />
                <h5>@($"Mængde: {Model.Product.Amount}")</h5>
            </div>
            <div class="col justify-content-center">
                <div class="d-flex justify-content-center" style="width: 250px; height: 40px;">
                    <button id="addRemoveBtn" class="btn btn-primary">-</button>
                    <input id="addRemoveBtn" class="" type="number" style="margin: 0;" value="@amount" />
                    <button id="addRemoveBtn" class="btn btn-primary">+</button>
                </div>

                <div class="justify-content-center">
                    <a class="btn btn-success" id="BookBtn" asp-controller="Product" asp-action="AddToBasket" asp-route-id="@Model.Product.ProductId" asp-route-id2="@amount" style="margin: 10px;">Book</a>
                </div>
            </div>
        </div>
    </div>
}
@section Scripts {
    <script>
        const link = document.getElementById('BookBtn');
        const amount = @Model.Product.Amount;
        link.addEventListener('click', (event) => {
            if (amount <= 0) {
                event.preventDefault();
                alert('Produktet er Udbookede ')
            }
        });
    </script>
}
