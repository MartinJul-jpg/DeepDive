@using DeepDive.ViewModels
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model BookingViewModel;


@{
    int amount = 1;
    <div class="container text-center m-5">
        <div class="row">
            <div class="col">
                <img src="~/lib/custom/resource/product-placeholder.png" class="card">
            </div>
            <div class="col productText">
                <h3>@($"{Model.Product.Brand}")</h3>
                <br />
                <h5>@($"{Model.Product.GetUniqueInfoPage()}")</h5>
                <br />
                <h5>@($"Pris: {Model.Product.Price} kr. per dage")</h5>
                <br />
                <h5>@($"Mængde: {Model.Product.Amount}")</h5>
            </div>
            <div class="col justify-content-center">
                <div class="d-flex justify-content-center" style="height: 40px;">
                    <button name="minusBtn" class="amountSelector btn btn-primary">-</button>
                    <input class="amountSelector" type="number" style="margin: 0;" value="@amount" />
                    <button name="addBtn" class="amountSelector btn btn-primary">+</button>
                </div>

                <div class="justify-content-center">
                    <form asp-controller="Product" asp-action="AddToBasket" method="get">
                        <input type="hidden" name="id" value="@Model.Product.ProductId" />
                        <input type="hidden" name="amount" id="amountInput" value="@amount" />

                        <button type="submit" class="btn btn-success" style="margin: 10px;">Book</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
@section Scripts {
    <script>
        // Plus button click
        const plusBtn = document.querySelector('button[name="addBtn"]');
        plusBtn.addEventListener('click', () => {
            quantityInput.value = parseInt(quantityInput.value) + 1;
            amountInput.value = quantityInput.value;
        });

        // Minus button click
        const minusBtn = document.querySelector('button[name="minusBtn"]');
        minusBtn.addEventListener('click', () => {
            if (parseInt(quantityInput.value) > 1) {
                quantityInput.value = parseInt(quantityInput.value) - 1;
                amountInput.value = quantityInput.value;
            }
        });

        // Update amount when typed or clicked
        const quantityInput = document.querySelector('input[type="number"]');
        const amountInput = document.getElementById('amountInput');

        quantityInput.addEventListener('input', () => {
            amountInput.value = quantityInput.value;
        });


        // Prevent booking if amount is 0 or less
        const link = document.getElementById('BookBtn');
        const amount = @Model.Product.Amount;
        link.addEventListener('click', (event) => {
            if (amount <= 0) {
                event.preventDefault();
                alert('Produktet er Udbookede ')
            }
        });
    </script>
}
