@using DeepDive.ViewModels
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model BookingViewModel;
@section categorySector {
    <div id="categoryDiv">
        <a asp-controller="Category" asp-action="Show" asp-route-id="BCD" class="btn categoryBtn btn-secondary">
            BCD
        </a>
        <a asp-controller="Category" asp-action="Show" asp-route-id="DivingSuit" class="btn categoryBtn btn-secondary">
            Dragter
        </a>
        <a asp-controller="Category" asp-action="Show" asp-route-id="Fin" class="btn categoryBtn btn-secondary">
            Finner
        </a>
        <a asp-controller="Category" asp-action="Show" asp-route-id="RegulatorSet" class="btn categoryBtn btn-secondary">
            Regulatorsæt
        </a>
        <a asp-controller="Category" asp-action="Show" asp-route-id="Snorkel" class="btn categoryBtn btn-secondary">
            Snorkler
        </a>
        <a asp-controller="Category" asp-action="Show" asp-route-id="Tank" class="btn categoryBtn btn-secondary">
            Tanke
        </a>
    </div>
}
