@model AccountViewModel;
@inject AuthState AuthState;

<section class="auth-section container py-5">
    <div class="auth-card mx-auto shadow-sm">
        <div class="text-center mb-4">
            <h2 class="display-6 fw-bold mb-1">Log ind</h2>
        </div>

        @if (AuthState.IsLoggedIn)
        {
            <div class="alert alert-success text-center">
                Du er logget ind som <strong>@AuthState.Email</strong>.
            </div>

            <a class="btn btn-outline-secondary btn-lg w-100 shadow" asp-controller="Account" asp-action="Logout">
                Log ud
            </a>
        }
        else
        {
            <form asp-controller="Account" asp-action="Login" method="post">

                <div class="mb-3">
                    <label asp-for="LoginModel.Email" class="form-label">E-mail</label>
                    <input asp-for="LoginModel.Email" type="email" class="form-control" placeholder="navn@eksempel.dk" />
                    <span asp-validation-for="LoginModel.Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="LoginModel.Password" class="form-label">Adgangskode</label>
                    <input asp-for="LoginModel.Password" type="password" class="form-control" />
                    <span asp-validation-for="LoginModel.Password" class="text-danger"></span>
                </div>

                <button type="submit" class="btn vv-primary btn-lg w-100 mt-2 shadow" disabled="@Model.IdentityApiService.IsBusy">
                    @if (Model.IdentityApiService.IsBusy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    }
                    Log ind
                </button>

                @if (Model.IdentityApiService.ErrorMessage is not null)
                {
                    <div class="alert alert-danger mt-4 mb-0">@Model.IdentityApiService.ErrorMessage</div>
                }
            </form>
        }
    </div>
</section>