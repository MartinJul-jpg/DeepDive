@using Microsoft.AspNetCore.Identity
@using Shared.Data
@inject AuthState AuthState

<ul class="navbar-nav">
    @if (AuthState.IsLoggedIn)
    {
        <li class="nav-item">
            <a id="manage" class="nav-link text-dark" title="Manage">Hello @AuthState.Email!</a>
        </li>
        <li class="nav-item">
            <form id="logoutForm" class="form-inline" href="@Url.Action("Index", "Home")">
                <button id="logout" type="submit" class="nav-link btn btn-link text-dark border-0">Logout</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" id="register" href="register">Register</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" id="login" href="login">Login</a>
        </li>
    }
</ul>




