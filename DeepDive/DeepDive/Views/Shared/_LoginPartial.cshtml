@using Microsoft.AspNetCore.Identity
@using Shared.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">

    @if (SignInManager.IsSignedIn(User))
    {
        var email = UserManager.GetUserName(User) ?? "";
        var name = email.Split('@')[0];

        <li class="nav-item user-menu">
            @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
            {
                <a class="user-link" href="/Admin">
                    <span>ADMIN</span>
                </a>
            }
            <a class="user-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="@email">
                <span>@name</span>
            </a>
            <form asp-area="Identity" asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                <button type="submit" class="logout-btn">LOG UD</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="userBtn btn btn-secondary" id="login" asp-area="Identity" asp-page="/Account/Login">Log ind</a>
        </li>
    }
</ul>




