@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dive Deep</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.css" />
    <link rel="stylesheet" href="~/lib/custom/css/styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div id="headDiv">
            <a asp-controller="Home" asp-action="Index">
                <img src="~/lib/custom/resource/logo.png" id="logoImg">
            </a>
            <h1 id="head">
                DIVE DEEP
            </h1>
            <input id="searchInput">
            <button id="searchBtn">
                SØG
            </button>
            <a asp-controller="Basket" asp-action="Index" id="shoppingCartBtn" class="btn btn-primary">
                <img id="shoppingCart"
                     src="~/lib/custom/resource/whiteshoppingCart.png"
                     alt="Shopping cart">
            </a>
        </div>
        <div id="categoryDiv">
            <a asp-controller="Category" asp-action="Show" asp-route-id="BCD" class="btn categoryBtn btn-secondary">
                BCD
            </a>
            <a asp-controller="Category" asp-action="Show" asp-route-id="DivingSuit" class="btn categoryBtn btn-secondary">
                Dragter
            </a>
            <a asp-controller="Category" asp-action="Show" asp-route-id="Fin" class="btn categoryBtn btn-secondary">
                Finner
            </a>
            <a asp-controller="Category" asp-action="Show" asp-route-id="RegulatorSet" class="btn categoryBtn btn-secondary">
                Regulatorsæt
            </a>
            <a asp-controller="Category" asp-action="Show" asp-route-id="Snorkel" class="btn categoryBtn btn-secondary">
                Snorkler
            </a>
            <a asp-controller="Category" asp-action="Show" asp-route-id="Tank" class="btn categoryBtn btn-secondary">
                Tanke
            </a>
        </div>

    </header>
    <div>
        @RenderSection("categorySector", false)
    </div>
    <div class="container">
        @RenderBody()
    </div>
    <hr id="infoSeperator">
    <div id="footerDiv">
        <div class="footerBox">
            <h5 class="footerTitle">Information</h5>
            <ul class="footerList">
                <li>Åbningstider:</li>
                <ul id="openTimeList">
                    <li>Mandag-fredag: 10:00 - 17:30 </li>
                    <li>Lørdag: 10:00 - 14:00</li>
                    <li>Søndag: Lukket</li>
                </ul>
            </ul>
        </div>
        <div class="footerBox">
            <h5 class="footerTitle">Kundeservice </h5>
            <ul class="footerList">
                <li>
                    +45 60 70 80 90
                </li>
                <li>
                    info@divedeep.dk
                </li>
            </ul>
        </div>
        <div class="footerBox">
            <h5 class="footerTitle">Dive Deep A/S</h5>
            <ul class="footerList">
                <li>Adresse:</li>
                <li> Dykkervej 10</li>
                <li>5000 Odense C</li>
                <br />

                <li>CVR: 81828384</li>
            </ul>
        </div>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>