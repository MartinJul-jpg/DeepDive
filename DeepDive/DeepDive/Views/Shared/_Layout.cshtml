                <li>
                    Adresse her
                </li>
                <li>
                    Åbningstider
                </li>

            </ul>
        </div>
        <div class="footerBox">
            Customer Service <br>
            <ul class="footerList">
                <li>
                    +45 12 34 56 78
                </li>
                <li>
                    mail@Customersupport.dk
                </li>

            </ul>
        </div>
        <div class="footerBox">
            Dive Deep A/S <br>
            <ul class="footerList">
                <li>
                    Adresse
                </li>
