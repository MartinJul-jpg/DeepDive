@model Confirmation;

<form class="FormWidth" asp-controller="Basket" asp-action="Confirmation" method="post">
    <div class="form-group">
        <label >Navn</label>
        <input type="text" class="form-control" id="validationDefault01" placeholder="Skriv navn" asp-for="Name" required>
    </div>

    <div class="form-group">
        <label for="exampleInputEmail1">Email</label>
        <input type="email" class="form-control" id="exampleInputEmail1 validationDefault02" aria-describedby="emailHelp" placeholder="Skriv email" asp-for="Email" required>
    </div>

    <div class="form-group">
        <label >Telefon</label>
        <input type="text" class="form-control" placeholder="Skriv telefonnummer" id="validationDefault03" asp-for="Tlf" required>
    </div>

    <button id="bookButton" type="submit" class="btn btn-primary" >Book</button>
</form>