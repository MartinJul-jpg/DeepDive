@model Booking;
@using DeepDive.Repository;
@using DeepDive.Models;
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@section categorySector {
    <div id="categoryDiv">
        <a asp-controller="Category" asp-action="Show" asp-route-id="BCD" class="btn categoryBtn btn-secondary">
            BCD
        </a>
        <a asp-controller="Category" asp-action="Show" asp-route-id="DivingSuit" class="btn categoryBtn btn-secondary">
            Dragter
        </a>
        <a asp-controller="Category" asp-action="Show" asp-route-id="Fin" class="btn categoryBtn btn-secondary">
            Finner
        </a>
        <a asp-controller="Category" asp-action="Show" asp-route-id="RegulatorSet" class="btn categoryBtn btn-secondary">
            Regulatorsæt
        </a>
        <a asp-controller="Category" asp-action="Show" asp-route-id="Snorkel" class="btn categoryBtn btn-secondary">
            Snorkler
        </a>
        <a asp-controller="Category" asp-action="Show" asp-route-id="Tank" class="btn categoryBtn btn-secondary">
            Tanke
        </a>
    </div>
}
<div>
    <br />
    <h1>Kurv</h1>

    @{
        if (Model != null)
        {
            <div class="card cartCard">
                <form id="bookingForm" asp-controller="Basket" asp-action="Index" class="d-flex">
                    @for (int i = 0; i < Model.BookedProducts.Count(); i++)
                    {
                        <input type="hidden" asp-for="BookedProducts[i]" />
                    }
                    <div class="col">
                        <h5 class="fw-bold">Start Dato</h5>
                        <input type="date" asp-for="Start" onchange="document.getElementById('bookingForm').submit()" class="w-50 p3" />
                        <br />
                    </div>
                    <div class="col">
                        <h5 class="fw-bold">Slut Dato</h5>
                        <input type="date" asp-for="End" onchange="document.getElementById('bookingForm').submit()" class="w-50 p3" />
                    </div>
                </form>


                <br />
                <h4>Vare:</h4>
                @foreach (int productId in Model.BookedProducts)
                {
                    Product product = ProductRepository.GetProductById(productId);
                    <a id="productText" asp-controller="Product" asp-action="Show" asp-route-id="@($"{product.ProductId}")" id="cartItem">@product.GetProductBrand() - Pris pr. dag: Kr. @product.GetProductPrice().ToString(),-</a> <br />
                }
                <h5>Total pris: Kr. @Model.TotalPrice.ToString(),-</h5>
                <br />
                <div>
                    <div>
                    </div>
                    <div>
                    </div>
                </div>
                <div class="align-content-end d-flex justify-content-center flex-wrap">
                    <form asp-controller="Basket" asp-action="Add">
                        @for (int i = 0; i < Model.BookedProducts.Count(); i++)
                        {
                            <input type="hidden" asp-for="BookedProducts[i]" />
                        }
                        <input type="hidden" asp-for="Start" />
                        <input type="hidden" asp-for="End" />
                        <input class="bottomCartBtn btn btn-success" style="width: 6rem;" type="submit" value="Book" />
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="card cartCard">
                <h5>Kurven er tom</h5>
            </div>
        }
    }
</div>