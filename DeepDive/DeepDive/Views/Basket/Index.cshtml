@model Booking;
@using DeepDive.Repository;
@using DeepDive.Models;
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div>
    <h1>Kurv</h1>

    @{
        Booking booking = BookingRepository.booking;
        if (booking != null)
        {
            <div class="card cartCard">
                <div class="d-flex">
                    <form id="bookingForm" asp-controller="Basket" asp-action="Edit" class="d-flex">
                        <input type="hidden" asp-for="BookedProducts" />
                        <div class="col">
                            <h5 class="fw-bold">Start Dato</h5>
                            <input type="date" asp-for="@booking.Start" onchange="document.getElementById('bookingForm').submit()" class="w-50 p3" />
                            <br />
                        </div>
                        <div class="col">
                            <h5 class="fw-bold">Slut Dato</h5>
                            <input type="date" asp-for="@booking.End" onchange="document.getElementById('bookingForm').submit()" class="w-50 p3" />
                        </div>
                    </form>
                </div>


                <br />
                <h4>Vare:</h4>
                @foreach (int productId in booking.BookedProducts)
                {
                    Product product = ProductRepository.GetProductById(productId);
                    <a id="productText" asp-controller="Product" asp-action="Show" asp-route-id="@($"{product.ProductId}")" id="cartItem">@product.GetProductBrand() - Pris pr. dag: Kr. @product.GetProductPrice().ToString(),-</a> <br />
                }
                <h5>Total pris: Kr. @booking.TotalPrice.ToString(),-</h5>
                <br />
                <div>
                    <div>
                    </div>
                    <div>
                    </div>
                </div>
                <div class="align-content-end">
                    <button class="bottomCartBtn btn btn-success">Book</button>
                    <button class="bottomCartBtn btn btn-danger">Slet</button>
                </div>
            </div>
        }
        else
        {
            <div class="card cartCard">
                <h5>Kurven er tom</h5>
            </div>
        }
    }
</div>