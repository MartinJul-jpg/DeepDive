@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}
<div class="container">
    <h1 class="login-h1">@ViewData["Title"]</h1>

    <div class="row">
        <div class="col-md-5">
            <section>
                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <h2 class="login-h2">Opret en ny konto.</h2>
                    <hr />
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="login-input form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="login-input-label">Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="login-input form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                        <label asp-for="Input.Password" class="login-input-label">Password</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.ConfirmPassword" class="login-input form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                        <label asp-for="Input.ConfirmPassword" class="login-input-label">Bekræft Password</label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>
                    <br />
                    <button id="registerSubmit" type="submit" class="login-btn-primary w-100 btn btn-lg btn-primary">Register</button>

                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Har du allerede en konto?</a>
                </form>
            </section>
        </div>
    </div>
</div>
<br />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
